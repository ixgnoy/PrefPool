# cre/.env.example
# cre/.env (gitignored) — runner laptop only
SIM_ENVELOPE_SK=            # X25519 secret key, hex (Day-0 keygen)
SIM_REPORT_SK=              # Ed25519 secret key, hex (Day-0 keygen)
SIM_PLATFORM_TOKEN=         # same value as server CRE_PLATFORM_TOKEN
CRE_SOLANA_PRIVATE_KEY=     # required by the CLI once project.yaml lists solana-devnet; unfunded, never signs (the workflow writes nothing on-chain)
