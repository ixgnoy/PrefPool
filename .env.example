# Which service gets what: server = Railway (root railway.json, Singapore), web = Vercel, cre-runner = a machine with `cre login`
# (your laptop or a small VM; see scripts/deploy/cre-runner.service). scripts/deploy/bootstrap.sh sets the server and web values from this file.
# server (Railway)
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000          # CORS
SUPABASE_DB_URL=                          # Supabase Session-pooler URI (postgresql://postgres.<ref>:<pw>@...:5432/postgres)
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=Cm1NmUPngoFke9pc8zXsK2qebBEfPb76bS3gHfjMS2hN   # campaign_escrow on devnet
RELAYER_SECRET_KEY=                       # base58 or JSON byte array (64 bytes); devnet wallet that pays the settle tx fees
ENVELOPE_X25519_PK=                       # hex
REPORT_ED25519_PK=                        # hex
CRE_PLATFORM_TOKEN=                       # 64 hex; same value as SIM_PLATFORM_TOKEN
CRE_RUNNER_TOKEN=                         # 64 hex
SYNTHETIC_SECRET=                         # 64 hex; derives synthetic agent tokens
# cre/.env (runner laptop only, gitignored)
SIM_ENVELOPE_SK=
SIM_REPORT_SK=
SIM_PLATFORM_TOKEN=
# cre-runner
SERVER_URL=
CRE_RUNNER_TOKEN=
CRE_TARGET=staging-settings               # production-settings uses cre/aggregate/config.production.json (hosted platformUrl)
# web (Vercel)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# World ID personhood (optional; feature off unless the first three are set). Signing key: server only, never commit.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENV=staging
