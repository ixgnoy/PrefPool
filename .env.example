# Which service gets what: server and facilitator = Railway services built from the root railway.json
# (facilitator needs only SERVICE_ROLE=facilitator, RELAYER_SECRET_KEY, SOLANA_RPC_URL, FACILITATOR_TOKEN), web = Vercel, cre-runner = the `cre login` laptop.
# Production setup and CI/CD: docs/implementation/DEPLOY.md (scripts/deploy/bootstrap.sh sets all of these from this file).
# server (Railway)
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000          # CORS
SUPABASE_DB_URL=                          # Supabase Session-pooler URI (postgresql://postgres.<ref>:<pw>@...:5432/postgres)
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=Cm1NmUPngoFke9pc8zXsK2qebBEfPb76bS3gHfjMS2hN   # campaign_escrow on devnet
RELAYER_SECRET_KEY=                       # base58 or JSON byte array (64 bytes); devnet wallet that pays settle fees and is the x402 fee payer
# Research report fee over x402 (Solana devnet, `exact` scheme, USDC 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU).
# PLATFORM_FEE_PAY_TO or FACILITATOR_URL unset: GET /api/campaigns/:id/report answers 503.
PLATFORM_FEE_USDC=3
PLATFORM_FEE_PAY_TO=                      # Solana address receiving the report fee (its USDC token account must exist)
FACILITATOR_URL=http://localhost:4022     # self-hosted facilitator: npm run facilitator -w @as/server
FACILITATOR_TOKEN=                        # >= 32 chars; same value on server and facilitator (required when the facilitator is not on loopback)
ENVELOPE_X25519_PK=                       # hex
REPORT_ED25519_PK=                        # hex
CRE_PLATFORM_TOKEN=                       # 64 hex; same value as SIM_PLATFORM_TOKEN
CRE_RUNNER_TOKEN=                         # 64 hex
SYNTHETIC_SECRET=                         # 64 hex; derives synthetic agent tokens
# cre/.env (runner laptop only, gitignored)
SIM_ENVELOPE_SK=
SIM_REPORT_SK=
SIM_PLATFORM_TOKEN=
# cre-runner
SERVER_URL=
CRE_RUNNER_TOKEN=
CRE_BROADCAST=false
CRE_TARGET=staging-settings               # production-settings uses cre/aggregate/config.production.json (hosted platformUrl)
# web (Vercel)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# World ID personhood (optional; feature off unless the first three are set). Signing key: server only, never commit.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENV=staging
